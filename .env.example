# Claude API key: powers diary analysis, day review, weekly summary, and the Brain chat (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=
# Optional. Hours to add to MetaTrader 5 report times to get your local time.
# MT5 reports use the broker's server time; 2 turns UTC into South African time (SAST).
MT5_TIME_OFFSET_HOURS=2
# Optional. Rand per US dollar. Only used for an MT5 row that has no Profit value;
# normally P&L comes straight from MT5's Profit column. 16.2 is what Ava applied in Aug-Sep 2026.
MT5_FX_RATE=16.2
# Optional. AI model for diary analysis, Day Review, weekly summary and Brain.
# claude-sonnet-5 is quick; claude-opus-5-5 writes deeper reviews but takes longer.
ANTHROPIC_MODEL=claude-sonnet-5
